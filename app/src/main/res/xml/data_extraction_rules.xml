<?xml version="1.0" encoding="utf-8"?>
<!-- API-ключ лежит в настройках приложения, поэтому в облако и на другой телефон они не уходят. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
